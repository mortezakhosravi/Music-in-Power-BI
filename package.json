{
  "name": "visual",
  "description": "Play and pause songs from a URL column.",
  "version": "1.6.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mortezakhosravi/Music-in-Power-BI"
  },
  "license": "MIT",
  "scripts": {
    "pbiviz": "pbiviz",
    "start": "pbiviz start",
    "package": "pbiviz package --no-stats && latest=$(ls -t dist/songPlayerED*.pbiviz | head -n 1) && cp \"$latest\" dist/songPlayer.pbiviz && find dist -name 'songPlayerED*.pbiviz' -delete",
    "lint": "npx eslint .",
    "test": "node --experimental-strip-types --test test/playlist.test.ts test/layout.test.ts"
  },
  "dependencies": {
    "powerbi-visuals-api": "5.11.1",
    "powerbi-visuals-utils-formattingmodel": "6.0.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "eslint": "^9.11.1",
    "eslint-plugin-powerbi-visuals": "^1.0.0",
    "powerbi-visuals-tools": "7.2.1",
    "typescript": "5.5.4"
  }
}
