{
    "dataRoles": [
        {
            "displayName": "Song URL",
            "name": "url",
            "kind": "Grouping"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "url": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "url"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 1000
                        }
                    }
                }
            }
        }
    ],
    "objects": {
        "playback": {
            "displayName": "Playback",
            "properties": {
                "extraButtons": {
                    "displayName": "Previous, next, and stop",
                    "type": {
                        "bool": true
                    }
                },
                "sameSize": {
                    "displayName": "Same size",
                    "type": {
                        "bool": true
                    }
                },
                "autoplay": {
                    "displayName": "Auto play",
                    "type": {
                        "bool": true
                    }
                }
            }
        },
        "circle": {
            "displayName": "Circle",
            "properties": {
                "color": {
                    "displayName": "Color",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "design": {
                    "displayName": "Design",
                    "type": {
                        "enumeration": [
                            {
                                "value": "filled",
                                "displayName": "Filled icon"
                            },
                            {
                                "value": "outline",
                                "displayName": "Border line icon"
                            }
                        ]
                    }
                },
                "theme": {
                    "displayName": "Icon theme",
                    "type": {
                        "enumeration": [
                            {
                                "value": "classic",
                                "displayName": "Classic"
                            },
                            {
                                "value": "liquid",
                                "displayName": "iOS 27 Liquid Glass"
                            }
                        ]
                    }
                }
            }
        }
    },
    "suppressDefaultTitle": true,
    "privileges": [
        {
            "name": "WebAccess",
            "essential": true,
            "parameters": [
                "https://*",
                "http://*"
            ]
        }
    ]
}
