{
    "dataRoles": [
        {
            "displayName": "Song URL",
            "name": "url",
            "kind": "Grouping"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "url": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "url"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 1000
                        }
                    }
                }
            }
        }
    ],
    "objects": {
        "circle": {
            "displayName": "Circle",
            "properties": {
                "color": {
                    "displayName": "Color",
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
            }
        }
    },
    "suppressDefaultTitle": true,
    "privileges": [
        {
            "name": "WebAccess",
            "essential": true,
            "parameters": [
                "https://*",
                "http://*"
            ]
        }
    ]
}
